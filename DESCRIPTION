Package: retrogroup
Title: Reconstruct Patient-Level Subgroup Membership in Survival Data
Version: 0.0.2.9000
Authors@R: c(
  person(
    given = c("William", "Michael"),
    family = "Landau",
    role = c("aut", "cre"),
